
import Mathlib

open MvPolynomial Real Nat

set_option maxHeartbeats 0

theorem putnam_1987_b3
(F : Type*) [Field F]
(hF : (1 : F) + 1 ≠ 0)
: {(x, y) : F × F | x ^ 2 + y ^ 2 = 1} = {(1, 0)} ∪ {((r ^ 2 - 1) / (r ^ 2 + 1), (2 * r) / (r ^ 2 + 1)) | r ∈ {r' : F | r' ^ 2 ≠ -1}} := by
  apply Set.Subset.antisymm
  · -- LHS ⊆ RHS
    intro p hp
    cases' p with x y
    have hx : x ^ 2 + y ^ 2 = 1 := hp
    -- Case 1: y = 0
    have h_case1 : y = 0 → ((x, y) : F × F) ∈ ({(1, 0)} ∪ {((r ^ 2 - 1) / (r ^ 2 + 1), (2 * r) / (r ^ 2 + 1)) | r ∈ {r' : F | r' ^ 2 ≠ -1}}) := by
      intro hy_zero
      have h_x_sq : x ^ 2 = 1 := by
        rw [hy_zero] at hx
        simpa using hx

      have h_x_eq_1_or_neg1 : x = 1 ∨ x = -1 := by
        aesop (config := {
          maxRuleApplications := 40
          maxRuleApplicationDepth := 10
          maxNormIterations := 320
          enableUnfold := false
          useDefaultSimpSet := false
          })
          (add norm 100 (by norm_cast))
          (add norm 0 (by linarith))
          (add norm 0 (by nlinarith))
          (add norm 0 (by omega))
          (add norm 0 (by bound))
          (add norm 1 (by field_simp [*] at *))
          (add safe 100 (by ring))
          (add safe 100 (by field_simp))
          (add safe 100 (by norm_num))
          (add safe 0 (by split))
          (add safe 1 (by ring_nf at *))
          (add safe 0 (by norm_num [*] at *))
          (add safe 100 (by norm_cast at *))
          (add safe 100 (by decide))
          (add safe 0 (by push_cast))
          (add safe 100 (by assumption_mod_cast))
          (add norm 0 (by grind only [eq_or_eq_neg_of_sq_eq_sq]))
          (add norm 0 (by grind only [sq_eq_one_iff]))
          (add norm 0 (by grind only [sq_eq_sq_iff_eq_or_eq_neg]))
          (add norm 0 (by grind only [mul_self_eq_one_iff]))
          (add norm 0 (by grind only [sq_eq_zero_iff]))
          (add norm 0 (by grind only [And]))
          (add norm 0 (by grind only [SimpleGraph.Walk.IsEulerian.card_filter_odd_degree]))
          (add norm 0 (by grind only [or_true]))
          (add norm 0 (by grind only [quadratic_eq_zero_iff]))
          (add norm 0 (by grind only [Quaternion.star_eq_self]))
          (add norm 0 (by grind only [pow_eq_zero]))
          (add norm 0 (by grind only [Quaternion.star_eq_neg]))
          (add norm 0 (by grind only [or_not]))
          (add norm 0 (by grind only [legendreSym.eq_zero_mod_of_eq_neg_one]))
          (add norm 0 (by grind only [or_self_iff]))
          (add norm 0 (by grind only [Nat.even_or_odd]))
          (add norm 0 (by grind only [legendreSym.eq_one_of_sq_sub_mul_sq_eq_zero]))
          (add norm 0 (by grind only [mul_eq_one]))
          (add norm 0 (by grind only [DirichletCharacter.even_or_odd]))
          (add norm 0 (by grind only [neg_one_sq]))
          (add norm 0 (by grind only [legendreSym.eq_one_of_sq_sub_mul_sq_eq_zero']))
          (add norm 0 (by grind only [quadraticChar_dichotomy]))
          (add norm 0 (by grind only [mul_eq_zero]))
          (add norm 0 (by grind only [FiniteInter.finiteInterClosure_insert]))
          (add norm 0 (by grind only [ArithmeticFunction.moebius_sq_eq_one_of_squarefree]))
          (add norm 0 (by grind only [or_self]))
          (add norm 0 (by grind only [false_or_iff]))
          (add norm 0 (by grind only [or_iff_left]))
          (add norm 0 (by grind only [true_or]))
          (add unsafe 10% (by grind only [Or]))
          (add unsafe 10% (by grind only [Or.elim]))
          (add unsafe 10% (by grind only [Or.imp]))

      cases' h_x_eq_1_or_neg1 with h1 h2
      · -- x = 1
        simp [h1]
        <;> aesop

      · -- x = -1
        -- Note: (-1, 0) is not in {(1,0)}. We need to check if it can be represented via the parametrization.
        -- Actually, the standard parametrization misses (-1, 0). But let's see what the problem says.
        -- The problem statement implies equality. Let's re-read carefully.
        -- Usually, rational points on circle are parametrized this way, missing (-1,0).
        -- So if x = -1 and y = 0, we must show it's in the set.
        -- Is (-1, 0) in the union? It's not in {(1,0)}.
        -- Can we find r such that (r^2-1)/(r^2+1) = -1 and 2r/(r^2+1) = 0?
        -- 2r/(r^2+1) = 0 => r = 0.
        -- If r = 0, (0^2-1)/(0^2+1) = -1/1 = -1.
        -- And 0^2 ≠ -1 is true unless char F = 2 (excluded) or specific fields.
        -- Since 0^2 = 0, we need 0 ≠ -1, which is true since 1≠0 in a field.
        -- So (-1, 0) corresponds to r = 0.
        have h_r_0 : (0 : F) ^ 2 ≠ -1 := by
          simp [hF] -- 0 ≠ -1 because 1 ≠ 0

        simp [h2] at *
        -- We need to show (-1, 0) is in the set generated by r=0
        simp [hy_zero, sq]
        refine Or.inr ⟨0, ?_⟩ <;> simp_all

    -- Case 2: y ≠ 0
    have h_case2 : y ≠ 0 → ((x, y) : F × F) ∈ ({(1, 0)} ∪ {((r ^ 2 - 1) / (r ^ 2 + 1), (2 * r) / (r ^ 2 + 1)) | r ∈ {r' : F | r' ^ 2 ≠ -1}}) := by
      intro hy_ne_zero
      -- We want to find r such that x = (r^2-1)/(r^2+1) and y = 2r/(r^2+1).
      -- From informal proof, r = (1+x)/y.
      let r := (1 + x) / y
      have h_denom_ne_zero : y ≠ 0 := hy_ne_zero
      -- Check that r^2 ≠ -1
      have h_r_sq_ne_neg1 : r ^ 2 ≠ -1 := by
        intro h_contra
        have h_y_nonzero : y ≠ 0 := hy_ne_zero
        -- If r^2 = -1, then (r^2+1)=0.
        -- Substitute back into expressions for x and y.
        -- This would imply contradictions with x^2+y^2=1 in a field where 2≠0.
        -- Specifically, if r^2 = -1, then r^2+1=0.
        -- The parametrization formulas involve division by r^2+1.
        -- However, we derived r from x,y assuming the denominator was non-zero.
        -- Let's verify directly.
        have h_sum : x ^ 2 + y ^ 2 = 1 := hx
        have h_r_def : r = (1 + x) / y := rfl
        rw [h_r_def] at h_contra
        have h_contra_calc : ((1 + x) / y) ^ 2 = -1 := h_contra
        have h_sq_num : ((1 + x) : F) ^ 2 = -(1 : F) * y ^ 2 := by
          aesop (config := {
            maxRuleApplications := 40
            maxRuleApplicationDepth := 380
            maxNormIterations := 320
            maxGoals := 512
            enableSimp := false
            enableUnfold := false
            })
            (add norm 100 (by norm_cast))
            (add norm 0 (by linarith))
            (add norm 0 (by nlinarith))
            (add norm 0 (by bound))
            (add norm 0 (by ring_nf))
            (add norm 1 (by ext))
            (add norm 1 (by field_simp [*] at *))
            (add safe 100 (by field_simp))
            (add safe 100 (by norm_num))
            (add safe 100 (by omega))
            (add safe 100 (by interval_cases))
            (add safe 0 (by split))
            (add safe 100 (by decide))
            (add safe 0 (by push_cast))
            (add safe 100 (by assumption_mod_cast))
            (add norm 0 (by grind only [mul_pow]))
            (add norm 0 (by grind only [neg_one_sq]))
            (add norm 0 (by grind only [neg_sq]))
            (add norm 0 (by grind only [mul_assoc]))
            (add norm 0 (by grind only [mul_one]))
            (add norm 0 (by grind only [neg_pow]))
            (add norm 0 (by grind only [quadraticChar_sq_one]))
            (add norm 0 (by grind only [ArithmeticFunction.moebius_sq_eq_one_of_squarefree]))
            (add norm 0 (by grind only [one_pow]))
            (add norm 0 (by grind only [two_ne_zero]))
            (add norm 0 (by grind only [one_mul]))
            (add norm 0 (by grind only [div_pow]))
            (add norm 0 (by grind only [even_two]))
            (add norm 0 (by grind only [quadraticChar_sq_one']))
            (add norm 0 (by grind only [sq_sub_sq]))
            (add norm 0 (by grind only [mul_comm]))
            (add norm 0 (by grind only [pow_mul]))
            (add norm 0 (by grind only [Even.neg_one_pow]))
            (add norm 0 (by grind only [qrSign.sq_eq_one]))
            (add norm 0 (by grind only [Stirling.stirlingSeq_pow_four_div_stirlingSeq_pow_two_eq]))
            (add norm 0 (by grind only [two_ne_zero']))
            (add norm 0 (by grind only [euler_four_squares]))
            (add norm 0 (by grind only [legendreSym.sq_one]))
            (add norm 0 (by grind only [ArithmeticFunction.moebius_sq]))
            (add norm 0 (by grind only [MulChar.IsQuadratic.sq_eq_one]))
            (add norm 0 (by grind only [pow_two]))
            (add norm 0 (by grind only [pow_add]))
            (add norm 0 (by grind only [mul_left_comm]))
            (add norm 0 (by grind only [pow_ne_zero]))
            (add norm 0 (by grind only [Odd.neg_one_pow]))
            (add safe 0 (by simp only [mul_div_assoc] at *))
            (add safe 0 (by simp only [div_self] at *))

        have h_expand_left : (1 + x) ^ 2 = 1 + 2 * x + x ^ 2 := by ring
        rw [h_expand_left] at h_sq_num
        have h_rhs : -(1 : F) * y ^ 2 = -y ^ 2 := by ring
        rw [h_rhs] at h_sq_num
        aesop (config := {
          maxRuleApplications := 40
          maxRuleApplicationDepth := 10
          maxNormIterations := 520
          maxGoals := 256
          enableSimp := false
          enableUnfold := false
          })
          (add norm 100 (by norm_cast))
          (add norm 0 (by linarith))
          (add norm 0 (by nlinarith))
          (add norm 0 (by bound))
          (add norm 0 (by ring_nf))
          (add norm 1 (by ext))
          (add norm 1 (by field_simp [*] at *))
          (add safe 100 (by field_simp))
          (add safe 100 (by norm_num))
          (add safe 100 (by omega))
          (add safe 0 (by split))
          (add safe 100 (by decide))
          (add safe 0 (by push_cast))
          (add safe 100 (by assumption_mod_cast))
          (add norm 0 (by grind only [sq_pos_of_pos]))
          (add norm 0 (by grind only [mul_pow]))
          (add norm 0 (by grind only [two_ne_zero]))
          (add norm 0 (by grind only [sq_sub_sq]))
          (add norm 0 (by grind only [CoxeterSystem.simple_sq]))
          (add norm 0 (by grind only [euler_four_squares]))
          (add norm 0 (by grind only [sq_eq_one_iff]))
          (add norm 0 (by grind only [div_pow]))
          (add norm 0 (by grind only [sq_nonneg]))
          (add norm 0 (by grind only [sq_eq_sq]))
          (add norm 0 (by grind only [sq_eq_zero_iff]))
          (add norm 0 (by grind only [sq_abs]))
          (add norm 0 (by grind only [quadraticChar_sq_one]))
          (add norm 0 (by grind only [pow_ne_zero]))
          (add norm 0 (by grind only [Int.isUnit_sq]))
          (add norm 0 (by grind only [gaussSum_sq]))
          (add norm 0 (by grind only [ArithmeticFunction.moebius_sq_eq_one_of_squarefree]))
          (add norm 0 (by grind only [ArithmeticFunction.moebius_sq]))
          (add norm 0 (by grind only [zero_lt_two]))
          (add norm 0 (by grind only [quadraticChar_sq_one']))
          (add norm 0 (by grind only [sq_lt_sq]))
          (add norm 0 (by grind only [neg_sq]))
          (add norm 0 (by grind only [neg_one_sq]))
          (add norm 0 (by grind only [Real.sq_sqrt]))
          (add norm 0 (by grind only [pow_pos]))
          (add norm 0 (by grind only [EisensteinSeries.r1]))
          (add norm 0 (by grind only [Iff]))
          (add norm 0 (by grind only [mul_left_cancel₀]))
          (add norm 0 (by grind only [QuaternionGroup.xa_sq]))
          (add unsafe 90% (by simp only [pow_two] at *))
          (add unsafe 50% (by simp only [sq_add_sq_mul]))
          (add unsafe 50% (by simp only [Pell.Solution₁.prop]))

      -- Now we know r^2 ≠ -1. We need to show the pair matches.
      aesop (config := {
        maxRuleApplications := 100
        maxRuleApplicationDepth := 10
        maxNormIterations := 320
        })
        (add norm 100 (by norm_cast))
        (add norm 0 (by linarith))
        (add norm 0 (by nlinarith))
        (add norm 0 (by omega))
        (add norm 0 (by bound))
        (add norm 0 (by ring_nf))
        (add norm 1 (by ext))
        (add norm 1 (by field_simp [*] at *))
        (add safe 100 (by field_simp))
        (add safe 100 (by norm_num))
        (add safe 100 (by positivity))
        (add safe 0 (by push_neg))
        (add safe 100 (by interval_cases))
        (add safe 0 (by split))
        (add safe 0 (by exfalso))
        (add safe 100 (by norm_cast at *))
        (add safe 100 (by rfl))
        (add safe 100 (by decide))
        (add safe 0 (by push_cast))
        (add safe 100 (by assumption_mod_cast))
        (add unsafe 50% (by ring_nf at *))
        (add norm 0 (by grind only [Set.mem_union]))
        (add norm 0 (by grind only [Set.mem_insert_iff]))
        (add norm 0 (by grind only [Set.mem_singleton_iff]))
        (add norm 0 (by grind only [Set.mem_setOf_eq]))
        (add norm 0 (by grind only [ZFSet.mem_insert_iff]))
        (add norm 0 (by grind only [Set.mem_setOf]))
        (add norm 0 (by grind only [Finset.mem_union]))
        (add norm 0 (by grind only [SimpleGraph.mk'_mem_incidenceSet_iff]))
        (add norm 0 (by grind only [true_or]))
        (add norm 0 (by grind only [FirstOrder.Language.Theory.model_iff]))
        (add norm 0 (by grind only [true_or_iff]))
        (add norm 0 (by grind only [Set.union_singleton]))
        (add norm 0 (by grind only [forall_eq]))
        (add norm 0 (by grind only [Set.mem_inter_iff]))
        (add norm 0 (by grind only [or_true_iff]))
        (add norm 0 (by grind only [SimpleGraph.boxProd_adj]))
        (add norm 0 (by grind only [or_true]))
        (add norm 0 (by grind only [or_not]))
        (add norm 0 (by grind only [and_or_left]))
        (add norm 0 (by grind only [Finset.mem_insert]))
        (add norm 0 (by grind only [or_self_iff]))
        (add norm 0 (by grind only [SimpleGraph.mem_neighborSet]))
        (add norm 0 (by grind only [SimpleGraph.mem_incidenceSet]))
        (add norm 0 (by grind only [AList.mem_insert]))
        (add norm 0 (by grind only [Finset.mem_singleton]))
        (add norm 0 (by grind only [SimpleGraph.Subgraph.sup_adj]))
        (add norm 0 (by grind only [ZFSet.mem_pair]))
        (add norm 0 (by grind only [ZFSet.mem_union]))
        (add norm 0 (by grind only [SimpleGraph.subgraphOfAdj]))
        (add norm 0 (by grind only [and_true]))
        (add norm 0 (by grind only [and_true_iff]))
        (add norm 0 (by grind only [false_or_iff]))

    -- Combine cases
    by_cases hy_zero : y = 0
    · have h_in_set : ((x, y) : F × F) ∈ ({(1, 0)} ∪ {((r ^ 2 - 1) / (r ^ 2 + 1), (2 * r) / (r ^ 2 + 1)) | r ∈ {r' : F | r' ^ 2 ≠ -1}}) := h_case1 hy_zero
      exact h_in_set

    · have h_in_set : ((x, y) : F × F) ∈ ({(1, 0)} ∪ {((r ^ 2 - 1) / (r ^ 2 + 1), (2 * r) / (r ^ 2 + 1)) | r ∈ {r' : F | r' ^ 2 ≠ -1}}) := h_case2 hy_zero
      exact h_in_set

  · -- RHS ⊆ LHS
    intro p hp
    cases' hp with h_left h_right
    · -- p = (1, 0)
      simp [h_left]
      · have h_pair : (1 : F) ^ 2 + (0 : F) ^ 2 = 1 := by norm_num
        aesop?

    · -- p is in the parametrized set
      rcases h_right with ⟨r, hr_ne, rfl⟩
      have h_denom_ne_zero : r ^ 2 + 1 ≠ 0 := by
        intro h_zero
        apply hr_ne
        exact eq_neg_of_add_eq_zero_left h_zero

      have h_sum_sq : ((r ^ 2 - 1) / (r ^ 2 + 1)) ^ 2 + ((2 * r) / (r ^ 2 + 1)) ^ 2 = 1 := by
        have h_num1 := pow_two (r ^ 2 - 1)
        have h_num2 := pow_two (2 * r)
        have h_den := pow_two (r ^ 2 + 1)
        field_simp [h_denom_ne_zero]
        ring_nf
        <;> simp_all
        <;> ring_nf at *
        <;> linarith

      exact h_sum_sq
