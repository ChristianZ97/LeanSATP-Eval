set_option maxHeartbeats 0

abbrev putnam_1975_a1_solution : ((ℤ × ℤ) → ℤ) × ((ℤ × ℤ) → ℤ) :=
  (fun p => p.1 + p.2 + 1, fun p => p.1 - p.2)
theorem putnam_1975_a1
