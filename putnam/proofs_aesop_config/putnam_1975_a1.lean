∀ n : ℤ, (∃ x y : ℤ, nxy (n, x, y)) → ∃ a b : ℤ, nab (n, a, b) := by
  constructor
  intro n a b h_nab
  have h_step_1 : (n : ℚ) = ((a : ℚ)^2 + (a : ℚ)) / 2 + ((b : ℚ)^2 + (b : ℚ)) / 2 := by
